PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/formforge
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string-xx
JWT_REFRESH_SECRET=change-me-to-a-random-32-char-string-xx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
APP_URL=http://localhost:3000
RESEND_API_KEY=re_placeholder
# SENTRY_DSN=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
# Where the browser reaches the API. Locally the API runs on its own port.
# Leave unset in production: on Vercel the API is served from the site's own
# origin (see vercel.json), and API_ORIGIN is injected by the service binding.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Only needed if the web app and API run on different subdomains of one site,
# e.g. app.example.com + api.example.com -> COOKIE_DOMAIN=.example.com
# COOKIE_DOMAIN=
